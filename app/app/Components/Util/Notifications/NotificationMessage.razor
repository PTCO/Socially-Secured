@inject NavigationManager NavigationManager

<div class="w-[390px] h-[103px] mb-[15px] ">
    <div class="flex items-center w-[100%] h-[65px] rounded-[15px] bg-[#E8E8E8] pl-[20px] pr-[15px] hover:cursor-pointer transition-all hover:scale-[1.02]" @onclick="@(() => NavigationManager.NavigateTo($"/Dashboard/Chat/Session/{ID}"))">
        <img src="@ProfilePicture" class="w-[48px] h-[48px] mr-[15px] rounded-full" alt="">
        <h1 class="@("montserrat-semibold !text-[26px] !mb-0") @(View ? null:"hidden")">@(Message.Split(" ")[0] + " " + Message.Split(" ")[1] + " " + Message.Split(" ")[2] +"...")</h1>
        <h1 class="@("montserrat-semibold !text-[26px] !mb-0") @(View ? "hidden":null)">Sent A Message</h1>
        <img src="images/User-Chat-Icon.png" class="ml-auto" alt="">
    </div>
    <div class="flex items-center mt-[5px]">
        <h2 class="montserrat-semibold !text-[24px] !mb-0">@Username</h2>
        <img src="images/Divider-Horizontal-Green-Small.png" class="mx-[15px]" alt="">
        <div class="flex items-center">
            <button class="@("bg-[#F1DDBF] hover:cursor-pointer transition-all hover:scale-[1.04] flex items-center justify-center !rounded-[5px] !mr-[10px] w-[29px] h-[29px]") @(View ? null:"!bg-[#525E75]")" @onclick="@(() => View = !View)">
                <img src="@(View ? "images/View-Icon.png":"images/View-Inactive-Icon.png")" alt="">
            </button>
            <button class="bg-[#FE5757] hover:cursor-pointer transition-all hover:scale-[1.04] flex items-center justify-center !rounded-[5px] w-[29px] h-[29px]" @onclick="@(() => DeleteNotification.InvokeAsync(ID))">
                <img src="images/Trash-Can-Icon.png" alt="">
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string Message { get; set; }
    [Parameter]
    public string Username { get; set; }
    [Parameter]
    public string ProfilePicture { get; set; }
    [Parameter]
    public int ID { get; set; }

    public bool View { get; set; } = true;

    [Parameter]
    public EventCallback<int> DeleteNotification { get; set; }

}