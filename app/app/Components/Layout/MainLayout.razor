@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject UserService UserService

<div class="page h-[100vh]">
    <div class="ml-[25px] mt-[25px]">
        <NavMenu />
    </div>
    <main>
        <article class="!px-0 h-[100vh] flex flex-column">
            @Body
            <MainFooter />
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized()
    {
        if(UserService.CurrentUser == null && !NavigationManager.Uri.Contains("/Login") && !NavigationManager.Uri.Contains("/Signup"))
        {
            // Redirect to login if the user is not authenticated
            NavigationManager.NavigateTo("/Login");
        }
        else if (UserService.CurrentUser != null && (NavigationManager.Uri.Contains("/Login") || NavigationManager.Uri.Contains("/SignUp")))
        {
            // Redirect to dashboard if the user is already authenticated
            NavigationManager.NavigateTo("/Dashboard/Search/");
        }
        StateHasChanged();
    }
}
