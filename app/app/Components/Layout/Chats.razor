@layout Layout.Dashboard
@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject ChatService ChatService
@inject UserService UserService
@inject NavigationManager NavigationManager
@using Chat
@using Microsoft.Extensions.FileSystemGlobbing.Internal.PathSegments

<section class="flex justify-center lg:!mt-[40px] mt-[75px] max-h-[670px] ">
    <article class="flex flex-column !w-[480px]">
        <div class="flex justify-center items-center w-fit">
            <h2 class="mr-[15px] !text-[36px] mb-0 lora-semibold">Chats</h2>
            <img src="images/Chats-Title-Icon.png" class="" alt="" srcset="">
            <img src="images/Divider-Vertical-Small-Gray.png" class="!mx-[20px]" alt="" srcset="">
            <h2 class="mr-[15px] !text-[36px] mb-0 lora-semibold">Blocked</h2>
            <img src="images/Blocked-Icon.png" class="" alt="" srcset="">
            <h3 class="!text-[32px] w-[56px] ml-[12px] lora-semibold mb-0">@blockedNumber</h3>
        </div>
        <div class="flex flex-column w-fit px-[5px] ml-[30px] !mt-[30px] overflow-y-auto overflow-x-hidden max-h-[643px] overscroll-contain " style="scrollbar-width: none;">
            @if(UserService.CurrentUser.Friends.Count > 0){
                @foreach ((Chat.ChatUser result, int index) in UserService.CurrentUser.Friends.Select((value, i) => (value, i)))
                {
                    var colorClass = colorClasses[index % colorClasses.Count];
                        <UserCard 
                            Username="@result.Username" 
                            NamePlateClass="@(colorClass)" 
                            ProfilePicture="@result.ProfilePicture" 
                            ChatID="@result.id" 
                            IsSelected="@(isSelected)" 
                            IsSearchResult=false
                            IsBlocked="@(UserService.CurrentUser.BlockedUsers.Contains(result.id))"
                            OnChatSelected="@(setCurrentChat)"
                            hasLink=true
                        />
                }
            }
            else {
                <img src="images/No-Users-Found.png" alt="No Results Found" class="w-[365px] h-[104px] mx-auto">
            }
        </div>
    </article>
    <img src="images/Vertical-Divider-Large.png" alt="" class="mx-[170px] mt-[59px] h-[452px]">
    <CascadingValue Value="this">
        @Body
    </CascadingValue>
</section>

@code {
    public List<string> colorClasses = new List<string> { "bg-[#F1DDBF]", "bg-[#78938A]  !text-[#fff]", "bg-[#E8E8E8]", "bg-[#476F95] !text-[#fff]"};
    public int isSelected = 0;
    public int blockedNumber = 0;

    protected async override void OnInitialized()
    {
        if(NavigationManager.Uri.Contains("Dashboard/Chats/Session"))
        {
            isSelected = int.Parse(NavigationManager.Uri.Split('/').LastOrDefault() ?? "0");
        }
        else
        {
            isSelected = 0;
        }
        setCurrentChat(isSelected);
        blockedNumber = UserService.CurrentUser.BlockedUsers.Count;
        Model.errorMessages.Clear();
        Model.SwitchUI("None");
        StateHasChanged();
    }

    public void UpdateChats(){
        blockedNumber = UserService.CurrentUser.BlockedUsers.Count;
        UserService.CurrentUser.Friends = UserService.CurrentUser.Friends;
        StateHasChanged();
    }

    public void setCurrentChat(int chatID)
    {
        isSelected = chatID;
        StateHasChanged();
    }
}