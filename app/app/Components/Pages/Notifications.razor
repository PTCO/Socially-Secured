@page "/Notifications"
@inject UserService UserService
@layout Layout.Dashboard

<section class="flex flex-column items-center">
    <article class="flex items-center mt-[75px]">
        <h2 class="lora-semibold text-[40px] mb-0">Notifications</h2>
        <img src="images/Notification-Icon.png" alt="" class="w-[55px] h-[55px] ml-[30px]" srcset="">
        <h3 class="mb-0  ml-[10px] lora-semibold text-[32px]">@(UserService.CurrentUser.NotificationMessages.Count + UserService.CurrentUser.Requests.Count)</h3>
    </article>
    <article class="flex  mt-[50px]">
        <article class="flex flex-column items-center w-[380px]">
            <div class="flex items-center  mb-[25px]">
                <h2 class="lora-semibold text-[40px] mb-0">Messages</h2>
                <img src="images/Notifications-Chat-Icon.png" class="ml-[15px]" alt="">
            </div>
            <div>
                @foreach(var message in UserService.CurrentUser.NotificationMessages)
                {
                    <NotificationMessage ID="@message.id" Message="@message.Message" Username="@message.Username" ProfilePicture="@message.ProfilePicture" DeleteNotification="DeleteNotification" />
                }
            </div>
        </article>
        <img src="images/Vertical-Divider-Large.png" alt="" class="mx-[170px]  h-[452px]">
        <article class="flex flex-column items-center justify w-[380px] max-h-[490px]">
            <div class="flex justify-center items-center w-[380px] mb-[25px]">
                <h2 class="lora-semibold text-[40px] mb-0">Requests</h2>
                <img src="images/User-Add-Chat-Icon-Large.png" class="ml-[15px] w-[50.55px] h-[44px]" alt="">               
            </div>
            <div class="overflow-y-auto overscroll-contain" style="scrollbar-width: none;">
                @foreach(var request in UserService.CurrentUser.Requests)
                {
                    <UserCard 
                        Username="@request.Username" 
                        NamePlateClass="@("!bg-[#E8E8E8]")" 
                        ProfilePicture="@request.ProfilePicture" 
                        ChatID="@request.id" 
                        IsSelected="@request.id"
                        IsRequest=true
                        IsSearchResult=false
                        hasLink=false
                        OnChatSelected="@(() => StateHasChanged())"
                    />
                }
            </div>
        </article>
    </article>
</section>

@code {
    public void DeleteNotification(int id)
    {
        UserService.CurrentUser.NotificationMessages.RemoveAll(m => m.id == id);

        // Add query to update the user in the database

        StateHasChanged();
    }
}