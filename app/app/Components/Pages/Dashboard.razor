@page "/Dashboard/Search/{query?}/{filter?}"
@layout Layout.Dashboard
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject UserService UserService
@using System.ComponentModel.DataAnnotations;

<section class="flex justify-center lg:!mt-[40px] mt-[75px] max-h-[670px]">
    <article class="flex flex-column">
        <div class="flex max-h-[50px] ">
            <EditForm Model="@SearchForm" class="flex flex-column items-center text-center w-[420px] ml-auto">
                <InputText @bind-Value="SearchForm.Query" class="w-[420px] !h-[50px]  lora-semibold  text-[20px] text-[#fff] px-[15px] !rounded-[15px] !bg-[#476F95] focus:!border-[#476F95] focus:!text-[#fff] focus:border-[4px] focus:!scale-[1.03] !outline-none" placeholder="Enter a username" />
            </EditForm>
            <button type="submit" @onclick="@(HandleSubmit)" class="flex items-center justify-center !w-[50px] !h-[50px] bg-[#E8E8E8] !rounded-[4px] !ml-[10px] hover:!scale-[1.05] transition-all">
                <img src="images/Search-Icon.png" alt="">
            </button>
        </div>
        <div class="flex flex-column w-fit px-[5px] ml-[60px] !mt-[30px] overflow-y-auto overflow-x-hidden max-h-[643px] overscroll-contain" style="scrollbar-width: none;">
            @if(UserService.CurrentUser.Strangers.Count > 0){
                @foreach ((var result, var index) in UserService.CurrentUser.Strangers.Select((value, i) => (value, i)))
                {
                    var colorClass = colorClasses[index % colorClasses.Count];
                        <UserCard 
                            Username="@result.Username" 
                            NamePlateClass="@(colorClass)"  
                            ProfilePicture="@result.ProfilePicture" 
                            ChatID="@result.id" 
                            IsSelected="@(isSelected)" 
                            IsSearchResult=true
                            OnChatSelected="@(setCurrentChat)"
                        />
                }
            }
            else {
                <img src="images/No-Users-Found.png" alt="No Results Found" class="w-[365px] h-[104px] mx-auto mt-[25px]">
            }
        </div>
    </article>

    <img src="images/Vertical-Divider-Large.png" alt="" class="mx-[170px] mt-[59px] h-[452px]">
    <article class="flex flex-column !w-[480px]">
        <div class="flex items-center">
            <h2 class="lora-semibold !text-[40px] text-[#000] !mb-[0] mr-[20px]">Filter</h2>
            <img src="images/Search-Page-Search-Icon.png" alt="" srcset="">
        </div>
        <nav>
            <ul class="list-none p-0 m-0">
                <li>
                    <div class="flex items-center mt-[30px]">
                        <CheckBox Class="mr-[10px] hover:scale-[1.05] hover:cursor-pointer" UnCheckedColor="bg-[#E8E8E8]" CheckedColor="bg-[#92BA92]" OnCheckChanged="HandleFilter"/>
                        <label class="montserrat-semibold text-[32px] text-[#000] ml-[15px]">Show Blocked Users</label>
                    </div>
                </li>
            </ul>
        </nav>
    </article>
</section>

@code {
    public class SearchFormModel
    {
        [Required(ErrorMessage = "Query is required.")]
        public string Query { get; set; }
    }

    public SearchFormModel SearchForm { get; set; } = new SearchFormModel();
    public List<string> colorClasses = new List<string> { "bg-[#F1DDBF]", "bg-[#78938A]  !text-[#fff]", "bg-[#E8E8E8]", "bg-[#476F95] !text-[#fff]" };
    public int isSelected = 0;

    [Parameter]
    public string query { get; set; } = string.Empty;

    [Parameter]
    public string filter { get; set; } = string.Empty;

    protected async override void OnInitialized()
    {
        Model.errorMessages.Clear();
        Model.SwitchUI("None");
        filter = await JS.InvokeAsync<string>("sessionStorage.getItem", "filter") ?? string.Empty;
        var json = Query.GetQuery("https://jsonplaceholder.typicode.com/users");// Change to correct API endpoint
        UserService.CurrentUser.Strangers = System.Text.Json.JsonSerializer.Deserialize<List<Chat.Chat.ChatUser>>(json) ?? new List<Chat.Chat.ChatUser>();
    }

    public void setCurrentChat(int chatID)
    {
        isSelected = chatID;
        StateHasChanged();
    }

    public async Task HandleFilter(bool isChecked) {
        if(isChecked)
            await JS.InvokeVoidAsync("sessionStorage.setItem", "filter", "blocked");
        else
            await JS.InvokeVoidAsync("sessionStorage.removeItem", "filter");
    }

    public async Task HandleSubmit()
    {
        var json = "";
        Model.errorMessages.Clear();
        filter = await JS.InvokeAsync<string>("sessionStorage.getItem", "filter") ?? string.Empty;
        if(filter != null && filter != "")
        {
            if(SearchForm.Query != null && SearchForm.Query != "")
            {
                NavigationManager.NavigateTo($"/Dashboard/Search/{SearchForm.Query}/{filter}");
                json = Query.GetQuery($"https://jsonplaceholder.typicode.com/users?username={SearchForm.Query}&blocked=true"); // Change to correct API endpoint
            }
            else {
                NavigationManager.NavigateTo($"/Dashboard/Search/{filter}");
                json = Query.GetQuery($"https://jsonplaceholder.typicode.com/users?blocked=true");// Change to correct API endpoint
            }
        }
        else 
        {
            if(SearchForm.Query != null && SearchForm.Query != "")
            {
                NavigationManager.NavigateTo($"/Dashboard/Search/{SearchForm.Query}");
                json = Query.GetQuery($"https://jsonplaceholder.typicode.com/users?username={SearchForm.Query}");// Change to correct API endpoint
            }
            else {
                NavigationManager.NavigateTo($"/Dashboard/Search");
                json = Query.GetQuery($"https://jsonplaceholder.typicode.com/users");// Change to correct API endpoint
            }
        }
        UserService.CurrentUser.Strangers = System.Text.Json.JsonSerializer.Deserialize<List<Chat.Chat.ChatUser>>(json) ?? new List<Chat.Chat.ChatUser>();
        StateHasChanged();
    }
}
